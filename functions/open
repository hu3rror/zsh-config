# ~/.config/zsh/functions/open - Open files/directories using xdg-open

emulate -L zsh

if ! command_is_available xdg-open; then
    print -u2 "open: xdg-open is not available — install xdg-utils"
    return 1
fi

local arg

if (( $# == 0 )); then
    xdg-open . >/dev/null 2>&1 &!
    return
fi

for arg in "$@"; do
    xdg-open "$arg" >/dev/null 2>&1 &!
done