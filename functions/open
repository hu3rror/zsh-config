# ~/.config/zsh/functions/open - Open files/directories using xdg-open

emulate -L zsh

local open_cmd
if (( $+commands[xdg-open] )); then
    open_cmd="xdg-open"
elif (( $+commands[open] )); then
    open_cmd="open"
else
    print -u2 "open: Neither xdg-open nor open is available."
    return 1
fi

local arg
if (( $# == 0 )); then
    $open_cmd . >/dev/null 2>&1 &!
    return
fi

for arg in "$@"; do
    $open_cmd "$arg" >/dev/null 2>&1 &!
done