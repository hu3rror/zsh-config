emulate -L zsh

local open_cmd
if command_is_available xdg-open; then
    open_cmd="xdg-open"
elif command_is_available open; then
    open_cmd="open"
else
    print -u2 "open: Neither xdg-open nor open is available."
    return 1
fi

local arg
if (( $# == 0 )); then
    $open_cmd . >/dev/null 2>&1 &!
    return
fi

for arg in "$@"; do
    $open_cmd "$arg" >/dev/null 2>&1 &!
done