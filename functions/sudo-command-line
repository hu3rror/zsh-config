# Autoload ZLE widget: sudo-command-line
# Prepends 'sudo' to the current command line buffer upon pressing ESC+ESC

[[ -z $BUFFER ]] && zle up-history
[[ -BUFFER != sudo\ * && $UID -ne 0 ]] && {
    typeset -a bufs
    bufs=(${(z)BUFFER})
    while (( $+aliases[$bufs[1]] )); do
        local expanded=(${(z)aliases[$bufs[1]]})
        bufs[1,1]=($expanded)
        if [[ $bufs[1] == $expanded[1] ]]; then
            break
        fi
    done
    bufs=(sudo $bufs)
    BUFFER=$bufs
}
zle end-of-line
