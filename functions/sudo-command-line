# Autoload ZLE widget: sudo-command-line
# Prepends 'sudo' to the current command line buffer upon pressing ESC+ESC

emulate -L zsh
if [[ -z $BUFFER ]]; then
    zle up-history
    return
fi
if [[ $BUFFER == sudo\ * ]]; then
    BUFFER="${BUFFER#sudo }"
else
    BUFFER="sudo $BUFFER"
fi
zle end-of-line