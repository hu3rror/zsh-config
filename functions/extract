# ~/.config/zsh/functions/extract - Archive Extraction Helper

emulate -L zsh

local file

for file; do
    [[ -f "$file" ]] || {
        print -u2 "extract: $file: not found"
        continue
    }

    case ${file:l} in
        (*.rar)
            if command_is_available unar; then
                unar "$file"
            elif command_is_available unrar; then
                unrar x -- "$file"
            else
                print -u2 "RAR support missing: install 'unar' (e.g. pacman -S unar)"
            fi
            ;;

        (*.7z)
            if command_is_available 7z; then
                7z x -- "$file"
            else
                print -u2 "7z support missing: install '7zip' (e.g. pacman -S 7zip)"
            fi
            ;;

        (*)
            bsdtar -xf -- "$file"
            ;;
    esac
done